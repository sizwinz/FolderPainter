{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FolderPainter",
  "version": "0.1.0",
  "identifier": "com.folderpainter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FolderPainter",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzRDVCNzYzNjZCRTUyRUEKUldUcVVyNW1ZN2ZWSTFTMmxqTUtFdGl3R1VCamJJYTd4YXR5Z21JZi96a0ZBWk04ZjFPbVJkWFcK",
      "endpoints": [
        "https://github.com/sahaj/FolderPainter/releases/latest/download/latest.json"
      ]
    }
  }
}